---
interface Props {
  index: string;
  title: string;
  lead: string;
  hero?: boolean;
}

const { index, title, lead, hero = false } = Astro.props;
---

<section class:list={['chapter', { 'chapter--hero': hero }]} data-chapter={index}>
  <div class="chapter__body">
    <p class="chapter__index">{index}</p>
    <h2 class="chapter__title">{title}</h2>
    <p class="chapter__lead">{lead}</p>
    {hero && <p class="chapter__hint">Przewiń</p>}
  </div>
</section>
